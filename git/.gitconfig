[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  meta = yellow bold
  frag = magenta bold
  old = red bold
  new = green bold
  whitespace = red reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[color "grep"]
  context = white bold
  function = green bold
  linenumber = white bold
  match = red bold
  selected = magenta bold
  separator = white

[color]
  ui = true

[core]
  editor=nvim
  ignorecase=false
  filemode=true
  pager = delta
  excludesfile = ~/.gitignore_global

[interactive]
  diffFilter = delta --color-only

[init]
  defaultBranch = master

[alias]
  a          = add
  ci         = commit -v
  co         = checkout
  sw         = switch
  rs         = restore
  unstage    = restore --staged
  amend      = commit --amend --no-edit
  undo       = reset --soft HEAD~1
  lol        = log --decorate --graph --abbrev-commit --oneline
  s          = status --short
  updatesubm = submodule foreach git pull --ff-only
  gre        = grep -C 2 -p --line-number

[push]
  default = simple
  autoSetupRemote = true

[fetch]
  prune = true
  pruneTags = true

[branch]
  autosetuprebase = always
  sort = -committerdate

[tag]
  sort = version:refname
  gpgsign = true

[pull]
  rebase = true

[merge]
  tool = vimdiff
  log = true
  conflictstyle = zdiff3

[rebase]
  stat = true

[rerere]
  enabled = true

[column]
  ui = auto

[log]
  abbrevCommit = true
  decorate = short

[commit]
  gpgsign=true

[diff]
  renameLimit=100000
  colorMoves = default
  algorithm = histogram

[delta]
  navigate = true
  side-by-side = true
  line-numbers = true
  dark = true

[include]
  path= ~/.gitconfig.local
